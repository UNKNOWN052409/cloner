# cloner platform — environment variables
# Copy to .env (gitignored) and fill in what you need. Every var below lists the
# file that actually reads it.

# ── Platform server ─────────────────────────────────────────────────────────
# Port for the platform UI + task API (bin/platform.js). --port wins over this.
PORT=4180

# ── Task retention ──────────────────────────────────────────────────────────
# Days before a task (and all its artifacts) is deleted by the retention sweep
# (boot + hourly). Garbage/zero/negative values fall back to 15
# (src/platform/tasks.js — sweepExpired guard). Default 15.
RETENTION_DAYS=15

# ── Credential purge on task end ────────────────────────────────────────────
# =1 → private/ (cookies, storage) is deleted the moment a task reaches
# done|error (src/platform/tasks.js — updateTask status transition).
# NOTE: credentials are ALSO always shredded on export (src/platform/exporter.js)
# regardless of this flag. Unset/any other value = keep session files until export.
PURGE_CREDS_ON_DONE=1

# ── Vision model keys (read by src/config.js, used by src/vision.js) ────────
# Needed for: element edit-chat (POST /api/tasks/:id/chat), vision polish,
# and the CLI image/video modes. URL cloning itself needs NO key (DOM is truth).
# provider=auto picks the first key present, in this order:
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=          # optional — custom Anthropic-compatible endpoint
ANTHROPIC_MODEL=             # optional — default claude-sonnet-4-5
OPENAI_API_KEY=              # also used for Whisper transcription (video mode)
CUSTOM_API_KEY=              # only used when provider=custom
CUSTOM_BASE_URL=             # only used when provider=custom (OpenAI-compatible /v1)

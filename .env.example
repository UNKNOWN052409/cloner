# cloner platform — environment variables
# Copy to .env (gitignored) and fill in what you need. Every var below lists the
# file that actually reads it.

# ── Platform server ─────────────────────────────────────────────────────────
# Port for the platform API (bin/platform.js). --port wins over this.
# G7.1: the platform is a HEADLESS BACKEND — there is no platform UI; clients
# integrate through /api/*, /ws, and the generated clones under /preview/:id.
PORT=4180

# ── Task retention ──────────────────────────────────────────────────────────
# Days before a task (and all its artifacts) is deleted by the retention sweep
# (boot + hourly). Garbage/zero/negative values fall back to 15
# (src/platform/tasks.js — sweepExpired guard). Default 15.
RETENTION_DAYS=15

# ── Credential purge on task end ────────────────────────────────────────────
# =1 → private/ (cookies, storage) is deleted the moment a task reaches
# done|error (src/platform/tasks.js — updateTask status transition).
# NOTE: credentials are ALSO always shredded on export (src/platform/exporter.js)
# regardless of this flag. Unset/any other value = keep session files until export.
PURGE_CREDS_ON_DONE=1

# ── Vision model keys (read by src/config.js, used by src/vision.js) ────────
# Needed for: element edit-chat (POST /api/tasks/:id/chat), vision polish,
# and the CLI image/video modes. URL cloning itself needs NO key (DOM is truth).
# provider=auto picks the first key present, in this order:
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=          # optional — custom Anthropic-compatible endpoint
ANTHROPIC_MODEL=             # optional — default claude-sonnet-4-5
OPENAI_API_KEY=              # also used for Whisper transcription (video mode)
OPENAI_BASE_URL=             # optional — OpenAI-compatible endpoint / relay
CUSTOM_API_KEY=              # only used when provider=custom
CUSTOM_BASE_URL=             # only used when provider=custom (OpenAI-compatible /v1)
# Key rotation (provider management API / POST /api/config/providers/:name/key)
# writes OPENAI_API_KEY / ANTHROPIC_API_KEY / CUSTOM_API_KEY (+ their base URLs)
# into process.env (live immediately) and into this file (durable across restarts):
CLONER_ENV_FILE=.env         # optional — defaults to ./.env

# ── Backup / recovery (scripts/backup-database.mjs, scripts/restore-database.mjs) ──
# Same PG* vars src/database/client.js reads; defaults match docker-compose.yml.
# PG_CONTAINER names the compose postgres container used when no host pg_dump
# exists (the dump runs inside it over the local socket — no password on any
# command line). See docs/BACKUP.md. Values here are the DEV defaults — in
# production provide them from your secret mechanism.
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=cloner
PGPASSWORD=cloner_dev_password
PGDATABASE=cloner
PG_CONTAINER=cloner-postgres-1

# ── Deployment (docker-compose.prod.yml — task 4.0.10) ─────────────────────
# docker compose -f docker-compose.prod.yml up -d --build
# REQUIRED entries are enforced at boot by src/config-schema.js with actionable
# errors; every REQUIRED value below must be provided by your secret mechanism
# (.env locally, secret manager in production) — never committed to source.

# Production mode. =production makes config-schema treat DB creds as required.
NODE_ENV=production

# Host port for the platform API (container listens on 4180 internally;
# headless since G7.1 — no platform UI is served).
PORT=4180

# PostgreSQL service in docker-compose.prod.yml (REQUIRED, no defaults in prod).
POSTGRES_USER=               # e.g. cloner
POSTGRES_PASSWORD=           # REQUIRED secret — injected via your secret manager
POSTGRES_DB=                 # e.g. cloner

# App-side PostgreSQL connection (REQUIRED in production).
# Inside the compose network the compose file forces PGHOST=postgres / PGPORT=5432;
# set these only for non-compose deployments.
PGHOST=                      # e.g. postgres (compose) or 127.0.0.1 (local)
PGPORT=                      # e.g. 5432 (compose) or 5433 (dev compose mapping)
PGDATABASE=                  # e.g. cloner
PGUSER=                      # e.g. cloner
PGPASSWORD=                  # REQUIRED secret — must match POSTGRES_PASSWORD

# Redis (REQUIRED for the worker process; optional for the API — when set the
# clone queue switches from in-process to BullMQ, src/queues/clone-queue.js).
# Inside compose this is forced to redis://redis:6379 by the compose file.
REDIS_URL=

# Worker concurrency cap (src/workers/clone-worker.js). Default 2.
MAX_CONCURRENT=

# Task retention sweep, days (src/platform/tasks.js). Default 15.
RETENTION_DAYS=

# =1 recommended in production: delete stored credentials when a task ends.
PURGE_CREDS_ON_DONE=1

# Browser pool (task 4.2.6: src/browser/browser-pool.js) — per-worker chromium
# lifecycle. Browsers are launched on demand, parked between leases, and
# recycled (closed + relaunched) after N navigations, over the RSS ceiling, or
# when they crash. Contexts are pooled per (cookies+viewport+storage) signature
# and reused warm up to maxContextUses. Defaults are sane; all knobs optional.
CLONER_POOL_MAX_BROWSERS=2       # default: MAX_CONCURRENT, min 1
CLONER_POOL_RECYCLE_AFTER_NAV=40 # main-frame navigations before forced recycle
CLONER_POOL_MEMORY_CEILING_MB=2048 # real OS RSS of the browser tree; recycle above
CLONER_POOL_MAX_CONTEXT_USES=10  # leases one warm context may serve
CLONER_POOL_MAX_CONTEXTS_PER_BROWSER=4
CLONER_POOL_IDLE_TIMEOUT_MS=120000 # idle parked browsers are closed after this
CLONER_POOL_ACQUIRE_TIMEOUT_MS=30000 # acquire fails with PoolAcquireTimeoutError
CLONER_POOL_MEMORY_SAMPLE_MS=3000  # RSS sample cache window (OS query ~0.8s)
CLONER_POOL_SWEEP_MS=15000         # background sweeper interval
CLONER_POOL_HEADED=0               # =1 launches visible browsers (debugging)

# ── Worker infrastructure (task 4.0.3: src/workers/clone-worker.js) ─────────
# Redis-backed BullMQ workers. Without REDIS_URL / CLONER_REDIS_URL the queue
# runs the in-process fallback (src/queues/clone-queue.js "memory" backend).
REDIS_URL=redis://127.0.0.1:6379
# Force the in-process queue even when Redis is reachable (G5.1: set this when
# the platform runs WITHOUT a standalone clone-worker process — otherwise jobs
# are handed to the bullmq queue and sit "active" forever with no consumer).
# Leave unset in the production server+worker split.
# CLONER_QUEUE_BACKEND=memory
# Verification wall-clock budget per verifyTask call (G5.1: bounds the
# 3-real-browser-stage × 3-round verification so a clone always reaches a
# terminal state on a loaded host).
CLONER_VERIFY_BUDGET_MS=480000
# Worker identity for heartbeats/log tagging. Default: clone-worker-<pid>
CLONER_WORKER_ID=
# Heartbeat interval (ms) and Redis key TTL (ms) — cloner:worker:heartbeat:<id>
CLONER_HEARTBEAT_MS=15000
CLONER_HEARTBEAT_TTL=45000
# Stalled-job recovery: how often the stalled check runs, how long a job lock
# lives, and how many stall re-dispatches before a job is marked failed
CLONER_STALLED_INTERVAL_MS=30000
CLONER_LOCK_DURATION_MS=30000
CLONER_MAX_STALLED_COUNT=2
# =0 disables worker-side progress persistence into task_stages (default on)
CLONER_PERSIST_STAGES=1

# ── Resource quotas (task 4.0.4: src/platform/quota-service.js) ─────────────
# Per-user/org defaults; a row in quota_limits overrides these per scope, and a
# NULL override value = unlimited. No commercial tiers are hard-coded.
# Max simultaneously RUNNING clone jobs per scope. Default 2.
QUOTA_MAX_CONCURRENT_JOBS=2
# Max parked (queued, pre-execution) jobs per scope. Default 10.
QUOTA_MAX_QUEUED_JOBS=10
# Max jobs started per UTC day per scope. Default 50.
QUOTA_MAX_JOBS_PER_DAY=50
# Artifact storage pool per scope in bytes. Default 5 GiB.
QUOTA_MAX_ARTIFACT_BYTES=5368709120
# Exploration CPU-minutes per UTC day per scope. Default 120.
QUOTA_MAX_EXPLORATION_MINUTES_PER_DAY=120
# Reservations older than this are reclaimed as 'stale' (worker crash
# reconciliation) by reclaimStaleReservations() / POST /api/quota/reconcile.
QUOTA_STALE_RESERVATION_MS=1800000

# ── Compute cost accounting (task 4.2.12: src/platform/compute-accounting.js) ─
# Per-job cost model: cost = ceil(runtime_ms/60000)×runtime_minute
#                       + browser_slots×browser_slot
#                       + artifact_bytes×artifact_byte   (credits, 6-dp exact)
# Env defaults; a row in compute_cost_rates overrides per scope (scope >
# platform 'global' row > env). The credit ledger itself is INJECTED (no env):
# the orchestrator wires the real ledger via setCreditLedger(ledger).
# Credits per started runtime minute. Default 0.01.
COMPUTE_RATE_RUNTIME_MINUTE=0.01
# Credits per browser slot consumed by a job. Default 0.005.
COMPUTE_RATE_BROWSER_SLOT=0.005
# Credits per stored artifact byte. Default 0.00000001 (0.01 credits/KB).
COMPUTE_RATE_ARTIFACT_BYTE=0.00000001
# Ledger currency unit reported with every cost record and debit. Default: credits.
COMPUTE_CURRENCY=credits

# ── API keys + rate limiting (task 4.0.6: src/platform/rate-limiter.js) ──────
# Per-key fixed-window limits applied by apiKeyAuth(scope) on the X-API-Key
# routes (POST /api/tasks, POST /api/jobs/explore). Redis backend when
# REDIS_URL is set, per-process memory fallback otherwise.
# Requests per API key per minute / per hour.
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_HOUR=600

# ── Auth throttle (G5.2 hunt: src/platform/server.js authThrottle) ───────────
# Per-IP fixed-window limits on POST /api/auth/register and /api/auth/login
# (same limiter backend as the API-key limiter). Stops credential stuffing and
# bcrypt CPU burn, which were previously unlimited on those endpoints.
AUTH_RATE_LIMIT_PER_MINUTE=15
AUTH_RATE_LIMIT_PER_HOUR=150

# ── Metrics exposure (G5.2 hunt: src/platform/health-routes.js) ──────────────
# /metrics is loopback-only by default (queue depth, task counts and worker
# topology are reconnaissance). Set to 1 to expose it to remote scrapers
# deliberately (e.g. an in-cluster Prometheus on a trusted network).
CLONER_METRICS_REMOTE=

# ── Workflow hooks (task 4.2.15: src/platform/workflow-hooks.js) ─────────────
# User-defined webhook receivers on task lifecycle events. 3 delivery attempts
# with exponential backoff, then the delivery is dead-lettered (operator replay
# via POST /api/hooks/dead-letters/:id/replay).
# Per-attempt receiver timeout, ms. Default 10000.
CLONER_HOOK_TIMEOUT_MS=10000
# Base backoff between attempts, ms (attempt gaps: base, base*2). Default 1000.
CLONER_HOOK_RETRY_BACKOFF_MS=1000
# Total attempts per delivery. Default 3.
CLONER_HOOK_MAX_ATTEMPTS=3
# =1 allows hook URLs pointing at loopback/private addresses (intranet
# receivers on a self-hosted deployment). Default: blocked, same SSRF posture
# as clone-task URLs. Independent from CLONER_ALLOW_PRIVATE_TARGETS.
# CLONER_HOOK_ALLOW_PRIVATE_TARGETS=0

# =1 allows CLONE-TASK URLs pointing at loopback/private addresses (local
# fixture sites during development: http://127.0.0.1:PORT/...). Default:
# blocked — enforced both at task creation (src/security/url-guard.js) and per
# browser request (src/security/request-guard.js). Read live per request;
# blocklisted names such as "localhost" stay blocked even when set.
# CLONER_ALLOW_PRIVATE_TARGETS=0

# ── Distributed job leases (task 4.2.8: src/distributed/job-leases.js) ──────
# Backend: "postgres" (default — leases live in the job_leases table, shared
# by every worker across regions; PostgreSQL now() is the clock authority) or
# "memory" (single-process fallback, no cross-region protection).
CLONER_LEASE_BACKEND=postgres
# Lease TTL per acquire/renew in ms. A lease not renewed within the TTL
# expires and may be stolen by another worker (epoch/fencing increments).
CLONER_LEASE_TTL_MS=30000
# Region tag recorded on each lease (cross-region takeover observability).
CLONER_LEASE_REGION=default
# Worker identity used for lease ownership. Falls back to CLONER_WORKER_ID,
# then lease-worker-<pid>.
CLONER_LEASE_WORKER_ID=

# ── Real OAuth — GOOGLE-ONLY (task 4.5.1: src/platform/oauth-real.js) ───────
# Google authorization-code login (GET /api/auth/oauth/google/start → Google →
# /api/auth/oauth/google/callback → session token). Email + password remains
# the PRIMARY login; OAuth is a secondary path.
# Client credentials from the provider's developer console — env only, never
# code. With both vars absent the provider reports 503 "not configured" and
# nothing else breaks.
#   Google:  console.cloud.google.com → APIs & Services → Credentials →
#            OAuth client ID (Web application). Authorized redirect URI must
#            be <public base>/api/auth/oauth/google/callback
#   GitHub OAuth sign-in was REMOVED (Google-only directive): the legacy
#   /api/auth/oauth/github/* routes answer 410 Gone and migration
#   043-oauth-google-only.sql unlinked any github account rows. GitHub is
#   still used for CODE PUBLISHING via PAT — see the section below.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Public base URL used to build redirect_uri + post-login redirect. Leave
# empty to derive it from the incoming request (x-forwarded-proto/host aware).
# Example: https://app.example.com
OAUTH_REDIRECT_BASE=

# Endpoint overrides — for self-hosted OIDC providers of the SAME wire
# protocol only. Defaults are the real production endpoints; do not set these
# in normal deployments.
# OAUTH_GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# OAUTH_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# OAUTH_GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# Single-use CSRF state lifetime in ms (default 600000 = 10 min).
OAUTH_STATE_TTL_MS=

# ── GitHub publishing (task G1.1: src/platform/github-publish-real.js) ──────
# REAL GitHub REST v3 publishing (create repo + git-data push + visibility).
# Classic PAT (ghp_…) with the `repo` scope. scripts/test-real-github.mjs also
# needs `delete_repo` for its self-cleanup (fine-grained tokens cannot delete
# repositories). Absent → publishing surfaces one clean actionable error; the
# product path is never mocked, so without a token it refuses to run.
GITHUB_PUBLISH_TOKEN=
# Optional GitHub Enterprise Server override — must point at a REAL GitHub/GHES
# instance (default https://api.github.com).
GITHUB_API_URL=

# ── REAL SMTP email (task G1.2: src/platform/email-real.js) ─────────────────
# REAL SMTP delivery — product code talks to this relay and never falls back to
# a mock. Absent env → surfaces one clean actionable error (503
# EMAIL_NOT_CONFIGURED on POST /api/email/send); nothing is sent and nothing is
# simulated. Optional dependency: when `nodemailer` is installed it is used as
# the transport, otherwise a first-party raw SMTP client (node:net/node:tls,
# EHLO/STARTTLS/AUTH PLAIN|LOGIN/DATA) does the job with zero new deps.
# SMTP_HOST + SMTP_PORT + SMTP_FROM are required. scripts/test-real-email.mjs
# performs a REAL send to SMTP_FROM itself when these are set (loud SKIP when
# they are not).
SMTP_HOST=
SMTP_PORT=587
# 587 → STARTTLS (upgraded automatically when the server offers it); 465 → set
# SMTP_SECURE=1 for implicit TLS on connect.
SMTP_SECURE=
# Leave empty for relays that accept unauthenticated sending; otherwise the
# client authenticates (PLAIN, falling back to LOGIN per server capabilities).
SMTP_USER=
SMTP_PASS=
# Envelope From / self-test recipient, e.g. cloner@your-domain.example
SMTP_FROM=
# Accept self-signed server certificates (self-hosted relays + local tests ONLY
# — never enable against a public relay).
SMTP_TLS_INSECURE=
# Per-operation timeout in ms (default 20000).
SMTP_TIMEOUT_MS=

# ── Distributed tracing (task 4.2.10: src/observability/trace-context.js, src/observability/trace-export.js) ──
# W3C traceparent propagation producer → queue → worker → stages, with span
# timing exported as JSON lines (one span per line, append-only). Tracing is
# sideband: a missing/dead sink or an unset dir NEVER fails a clone job.
# Off-switch — =0 disables export (spans stay in the in-process ring buffer).
CLONER_TRACING=
# Output directory for the span JSONL (default <cwd>/artifacts/traces).
CLONER_TRACE_DIR=
# Output file name inside CLONER_TRACE_DIR (default traces.jsonl).
CLONER_TRACE_FILE=

# ── Distributed worker plane (task 4.2.2: src/distributed/worker-plane.js) ──
# Region workers register with the worker plane (region, capabilities, load)
# and the execution plane routes jobs through per-region queue adapters built
# on the clone-queue contract (queue "clone-jobs:<region>").
# Heartbeat interval/TTL reuse CLONER_HEARTBEAT_MS / CLONER_HEARTBEAT_TTL above.
# Default region for workers/dispatches that omit one. Default: local
CLONER_WORKER_REGION=
# Auto-deregister (prune) a stale worker after this long without a heartbeat.
# Default 2 × CLONER_HEARTBEAT_TTL; <=0 disables pruning.
CLONER_WORKER_DEREGISTER_AFTER_MS=

# ── Distributed regions (task 4.2.1: src/distributed/region-registry.js, src/distributed/contracts.js) ──
# Region↔region auth secret for the shared contracts (HS256 bearer tokens).
# REQUIRED for any cross-region traffic; without it cross-region calls fail
# with a clean error (src/distributed/contracts.js — resolveRegionSecret).
# >=16 chars; provide from your secret mechanism — never commit a real value.
CLONER_REGION_SECRET=
# Optional JSON bootstrap of the region registry (coordinator side):
# [{"id":"region-a","endpoint":"http://127.0.0.1:9501","capabilities":["clone:url","vision:polish"]}]
# Regions can also be registered at runtime (POST /api/regions).
CLONER_REGIONS=
# Issuer id this coordinator signs region tokens with (default "local").
CLONER_REGION_ID=
# Root where region NODES store uploaded artifacts
# (default <cwd>/artifacts-regions/<regionId>).
CLONER_REGION_ARTIFACTS_ROOT=

# ── Plugin framework (task 4.2.14: src/integrations/plugin-framework.js) ─────
# First-party plugins are registered in-process (codePolicy: "in-process-
# first-party"); no third-party code is ever loaded into the control plane.
# Per-handler timeout bound so a hung plugin can never stall a task, a quota
# decision or the HTTP handler that fired the hook. Default 2000.
PLUGIN_HOOK_TIMEOUT_MS=2000

# ── External API surface: HMAC-signed webhooks OUT (task 4.2.14:
#    src/integrations/external-api.js) ───────────────────────────────────────
# Outbound signed deliveries are configured per target via env — nothing is
# hardcoded. Each target needs a URL and a shared secret; an optional EVENTS
# list filters which lifecycle events the target receives (absent = all):
#   CLONER_WEBHOOK_<NAME>_URL=https://receiver.example/hooks/cloner
#   CLONER_WEBHOOK_<NAME>_SECRET=<random 32+ bytes, shared with the receiver>
#   CLONER_WEBHOOK_<NAME>_EVENTS=task.completed,task.failed,quota.denied
# Delivery headers: X-Cloner-Signature: v1=HMAC-SHA256(secret,
# "v1.<timestamp>.<deliveryId>.<body>"), X-Cloner-Delivery (nonce UUID),
# X-Cloner-Timestamp (unix seconds), X-Cloner-Event. Replay-safe: timestamp
# tolerance 5 min + deliveryId nonce store (receivers mark the nonce only
# after processing; 5xx retries legitimately re-send the same deliveryId).
# With no target configured, deliverEvent() throws WebhookNotConfiguredError
# naming the env vars to set — clean error, never a silent drop.
# Minimum spacing between deliveries to the same target, ms (client-side
# rate limit). Default 50.
WEBHOOK_MIN_INTERVAL_MS=50

# ── Billing mode (task 4.5.2 zero-dollar-billing: src/platform/billing-stripe.js) ─
# OWNER DIRECTIVE: payment is $0 — the platform is FREE. Leave BILLING_MODE
# unset (the default) for the free platform: credits are granted for free and
# unlimited via the credit ledger (src/platform/credit-ledger.js) and NO Stripe
# call is ever made. The Stripe-compatible REST machinery only runs when
# BILLING_MODE=test AND STRIPE_SECRET_KEY is set — and even then every price is
# enforced $0. Any other value fails safe to the free noop mode.
#   unset | noop | free | off → free grants, machinery off (default)
#   test                      → machinery allowed (needs STRIPE_SECRET_KEY below)
#   anything else             → fails safe to free noop (with a warning)
BILLING_MODE=

# ── Stripe billing (task G1.3: src/platform/billing-stripe.js) ───────────────
# REAL Stripe REST integration (checkout sessions, customer portal, signed
# webhooks → credit grants). No SDK — plain REST against the Stripe wire API.
# Only active when BILLING_MODE=test (above); all prices are enforced $0.
# Routes: POST /api/billing/checkout, POST /api/billing/portal,
#         GET  /api/billing/credits, GET  /api/billing/status,
#         POST /api/billing/webhook   (mount billingRouter BEFORE express.json
#                                      so the webhook sees the raw body).
# With BILLING_MODE unset the checkout route is the free (noop) grant path — no
# key needed, no external call. With BILLING_MODE=test and no key the machinery
# stays off (still free grants) and the webhook route answers 503 actionable.
# Test-mode secret key (sk_test_…). NEVER a live key in development.
STRIPE_SECRET_KEY=
# Webhook signing secret for this endpoint (whsec_…, Stripe → Developers →
# Webhooks). Webhook deliveries with a missing/old/mismatched HMAC signature
# are rejected 400.
STRIPE_WEBHOOK_SECRET=
# Optional: Stripe-API-compatible gateway base (default https://api.stripe.com).
STRIPE_API_BASE=
# Optional: public origin used to build checkout success/cancel/portal-return
# URLs (default derives none — pass successUrl/cancelUrl per request instead).
STRIPE_PUBLIC_BASE_URL=
# Optional: full redirect URLs overriding the derived ones.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# Optional plan → price mapping, one per plan: STRIPE_PRICE_<PLAN>=price_…
# (plan "pro" → STRIPE_PRICE_PRO). POST /api/billing/checkout accepts either
# { price } directly or { plan: "pro" } resolved through this map.
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
# Optional: per-request timeout ms (default 15000) and webhook replay window
# seconds (default 300, per Stripe's recommended tolerance).
STRIPE_TIMEOUT_MS=15000
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# ── Regional artifact replication (task 4.2.3 — src/storage/artifact-replication.js) ──
# Copy-on-complete: every successfully completed job's artifact tree is copied to
# each configured regional root (real filesystem copy + per-replica SHA256 manifest
# + verify). Delivery (GET /api/replication/deliver/<jobId>/<file>) serves from the
# region nearest the caller and falls back to the ORIGIN tree when no replica is
# healthy — the feature is cleanly OFF (origin-only delivery) when unset.
# One region per comma/semicolon-separated spec: name=path or name@lat:lon=path
# (decimal degrees; ":" because the comma is the REGION separator). A spec without
# =path defaults to <project>/replicas/<name>. Paths must not contain , ; or @.
# Examples:
#   REPLICATION_REGIONS=eu-west=/mnt/replicas/eu,us-east=/mnt/replicas/us
#   REPLICATION_REGIONS=eu-west@48.85:2.35=D:/replicas/eu;us-east@40.71:-74.00=D:/replicas/us
REPLICATION_REGIONS=
# Integrity check the delivery resolver runs against a candidate replica before
# serving: hash (default — full SHA256 verify) | stat (sizes only) | off (manifest
# presence only). A failing candidate is skipped; the next-nearest region or the
# origin serves instead.
REPLICATION_DELIVERY_VERIFY=hash

# ── Notification delivery (task 4.2.16 — src/platform/notification-delivery.js) ──
# Email/webhook notifications with per-user preferences, per-event templates and
# rate-limited sends. Email uses a built-in RFC 5321 SMTP client (no dependency);
# webhooks are signed POSTs. Leave every SMTP_* unset → the email channel is
# cleanly skipped ("email_not_configured"); nothing sends and nothing crashes.
SMTP_HOST=                   # e.g. smtp.gmail.com / smtp-pulse.com / Mailpit 127.0.0.1
SMTP_PORT=                   # default 587 (or 465 when SMTP_SECURE=1)
SMTP_SECURE=                 # =1 → implicit TLS (port 465); else STARTTLS when offered
SMTP_STARTTLS=               # =0 → refuse the STARTTLS upgrade (default: use when offered)
SMTP_USER=                   # empty → no AUTH step
SMTP_PASS=
SMTP_FROM=                   # envelope + From header address, e.g. cloner@example.com
SMTP_FROM_NAME=Cloner
SMTP_EHLO_NAME=              # HELO/EHLO hostname (default: machine hostname)
SMTP_TIMEOUT_MS=15000
SMTP_TLS_REJECT_UNAUTHORIZED=  # =0 → accept self-signed certs (dev only)
# Per-user send budget (both channels share it): NOTIF_MAX_PER_MINUTE (default 10),
# NOTIF_MAX_PER_HOUR (default 50). Exceeded sends are logged as rate_limited.
NOTIF_MAX_PER_MINUTE=10
NOTIF_MAX_PER_HOUR=50

# ── Multi-region failover (task 4.2.9 — src/distributed/failover.js) ─────────
# Region-down detection, job re-route and artifact re-replication control plane.
# Heartbeats share the Redis above when set (REAL server-side TTL keys); with
# Redis unset the controller runs on the in-process store (single process).
CLONER_REGION_HEARTBEAT_TTL_MS=   # freshness window; a region silent past this is down. Default 45000 (3 missed beats)
CLONER_FAILOVER_TICK_MS=          # sweep interval for the periodic check(). Default 10000

# ── Worker autoscaling (task 4.2.4 — src/workers/autoscaler.js) ─────────────
# Scales a pool of clone workers on queue depth / oldest-job age / worker
# utilization. Anti-oscillation: sustain windows + hysteresis deadband (down
# thresholds MUST stay below the up ones) + directional cooldowns + step
# limits. Idle pools drain toward MIN_WORKERS with a safe drain
# (src/workers/worker-pool-manager.js: close only after active jobs reach 0).
CLONER_AUTOSCALE_MIN_WORKERS=1
CLONER_AUTOSCALE_MAX_WORKERS=8
CLONER_AUTOSCALE_MAX_PER_REGION=  # region-wide worker cap across all pools; blank = unlimited
CLONER_AUTOSCALE_EVALUATE_INTERVAL_MS=5000
# Scale-up signals (a signal must persist UP_SUSTAIN_MS before an action fires)
CLONER_AUTOSCALE_UP_QUEUE_DEPTH_PER_WORKER=4    # waiting jobs per running worker
CLONER_AUTOSCALE_UP_OLDEST_JOB_AGE_MS=30000     # oldest waiting job age (with depth > 0)
CLONER_AUTOSCALE_UP_UTILIZATION=0.8             # busy slots / total slots
CLONER_AUTOSCALE_UP_SUSTAIN_MS=10000
CLONER_AUTOSCALE_UP_COOLDOWN_MS=30000           # quiet gap after ANY action before an up
CLONER_AUTOSCALE_UP_STEP=2                      # max workers added per action
# Scale-down (hysteresis: these must stay BELOW the up thresholds)
CLONER_AUTOSCALE_DOWN_UTILIZATION=0.25
CLONER_AUTOSCALE_DOWN_QUEUE_DEPTH=0
CLONER_AUTOSCALE_DOWN_SUSTAIN_MS=30000
CLONER_AUTOSCALE_DOWN_COOLDOWN_MS=60000         # quiet gap after ANY action before a down
CLONER_AUTOSCALE_DOWN_STEP=1                    # max workers removed per action
# Fully idle pool (0 waiting + 0 active) for this long → drain toward min
CLONER_AUTOSCALE_IDLE_AFTER_MS=60000
# Safe-drain grace per removed worker before a forced close (reported as forced)
CLONER_DRAIN_TIMEOUT_MS=30000

# ── Verification: interaction requirement (task G4.1 — src/platform/verify.js) ─
# Stage-2 completeness requires documented behaviors + replay records (app clones).
# =0 lets control-free source pages pass with an explicit evidence line when the
# explorer recorded zero interactions on EVERY explored page (static docs/sites).
CLONER_VERIFY_REQUIRE_INTERACTIONS=   # default: strict (unset / any non-"0")

# ── Ad monetization (task 4.5.4 — src/monetization/ad-providers.js, ad-slots.js) ──
# Real ad-network delivery using the OFFICIAL network tags ONLY. Zone ids are
# harvested from the owner's logged-in dashboards (Monetag: Sites → zone → Get
# Code; Adsterra: Websites → zone code). Every zone left unset = ZERO ad
# output + an honest log line; nothing crashes. There is no traffic-generation
# code of any kind in this integration: no timer-driven re-rendering, no
# synthetic interactions, no fabricated events (scripts/test-ad-providers.mjs
# greps the sources to keep this enforced). Slots render as inert, clearly
# labelled containers that never mimic UI controls.
AD_PROVIDER_PRIMARY=monetag        # monetag | adsterra — the other network is the fallback (round-robin on failure)

# Per-slot zone ids. Slots: HEADER, MID_CONTENT, SIDEBAR, FOOTER.
MONETAG_ZONE_ID_HEADER=
MONETAG_ZONE_ID_MID_CONTENT=
MONETAG_ZONE_ID_SIDEBAR=
MONETAG_ZONE_ID_FOOTER=
# Official Monetag loader (default below; copy the exact src from your
# Monetag dashboard if your account ships a different loader URL).
MONETAG_LOADER_URL=https://fpyf8.com/88/tag.min.js

# Adsterra per slot: EITHER the full official invoke.js src pasted from the
# dashboard (e.g. //pl123456.profitablecpmrate.com/abcdef123456/invoke.js),
# OR a bare zone id plus ADSTERRA_LOADER_DOMAIN + ADSTERRA_ZONE_KEY_{SLOT}.
ADSTERRA_ZONE_ID_HEADER=
ADSTERRA_ZONE_ID_MID_CONTENT=
ADSTERRA_ZONE_ID_SIDEBAR=
ADSTERRA_ZONE_ID_FOOTER=
ADSTERRA_ZONE_KEY_HEADER=
ADSTERRA_ZONE_KEY_MID_CONTENT=
ADSTERRA_ZONE_KEY_SIDEBAR=
ADSTERRA_ZONE_KEY_FOOTER=
ADSTERRA_LOADER_DOMAIN=

# Loader availability probe (one GET of the official loader per provider+slot
# inside the cache window; a reachability check, not an ad request).
AD_PROBE_TIMEOUT_MS=3000
AD_PROBE_CACHE_MS=60000

# Frequency caps: max serves per (viewer session, slot) per rolling window.
# Overridable per slot at runtime via PUT /api/ads/settings/:slotKey (admin).
# capMax=0 disables ad serving entirely.
AD_FREQUENCY_CAP_MAX=1
AD_FREQUENCY_CAP_WINDOW_SECONDS=3600
AD_SESSION_SALT=                   # optional pin for the hashed-cap session ids (default: per-process random)

# ── Clone monetization opt-in (task 4.5.5 — src/runtimeTemplate.js hook,
#    src/platform/ads-optin.js) ──
# Generated clones carry ad slots ONLY when the task owner opted in for that
# clone (`monetize: true` on POST /api/tasks or POST /api/jobs/explore) AND at
# least one clone zone below is configured. Policy-safe default: OFF — an
# opted-out clone is byte-identical to a non-monetized one, ZERO ad markup.
# Opt-in with no zone configured is rejected (HTTP 400) before the task is
# created. Clone zones: header (directly after <body>) and footer (directly
# before </body>) — mid-content/sidebar are NOT emitted into clones.
# The zones reuse the same env keys as the platform slots above:
#   MONETAG_ZONE_ID_HEADER / MONETAG_ZONE_ID_FOOTER
#   ADSTERRA_ZONE_ID_HEADER / ADSTERRA_ZONE_ID_FOOTER
# (set them in the 4.5.4 block above; no separate keys are introduced)

# Per-task monetize flag API (src/monetization/ad-config-api.js, task 4.5.5):
#   GET /api/ad-config/tasks/:id   read the flag (derived truth: api store >
#                                  task.json > v2 job history > artifact evidence > OFF)
#   PUT /api/ad-config/tasks/:id   { "monetize": boolean } — owner or admin only.
#                                  Flipping the flag re-writes an ALREADY-GENERATED
#                                  clone (withAdSlots / withoutAdSlots, both cloner-
#                                  namespaced): the served preview and exported
#                                  artifact follow the owner's current choice. Opt-in
#                                  with no configured zone stays a clean 400.

# Task 4.2.5 — SECRET REFERENCE TEMPLATE (never applied).
#
# The file extension is ".yaml.example" on purpose: `kubectl apply -f k8s/`
# only picks up *.yaml / *.yml / *.json, so this skeleton can never leak into
# a real deployment by accident. Copy → fill → apply:
#
#   cp k8s/20-secrets.yaml.example k8s-local-secret.yaml   # keep it OUT of git
#   # fill every REPLACE_* placeholder (see below), then:
#   kubectl apply -f k8s-local-secret.yaml
#
# Values MUST come from your secret mechanism (kubectl create secret, sealed
# secrets, external-secrets, cloud secret manager CSI, …) — never commit real
# values. Every key below is one flagged secret:true in src/config-schema.js.
#
# Workloads reference this Secret BY NAME (cloner-secrets) via
# envFrom.secretRef — that is the "secrets-ref" contract: product code reads
# only environment variables; manifests carry no credential values, only
# references. The test suite verifies (a) no manifest other than this template
# contains secret values, (b) the template contains no credential-shaped
# values, only placeholders, (c) the referenced keys cover every secret the
# config schema requires in production.
---
apiVersion: v1
kind: Secret
metadata:
  name: cloner-secrets
  namespace: cloner
  labels:
    app.kubernetes.io/name: cloner-platform
    app.kubernetes.io/part-of: cloner-platform
type: Opaque
stringData:
  # REQUIRED (api, worker, migrator; NODE_ENV=production makes it fail-loud):
  # the application-side PostgreSQL password. Must match the password of the
  # postgres instance PGHOST points at (10-configmap.yaml).
  PGPASSWORD: "REPLACE_PGPASSWORD"

  # REQUIRED (worker; also switches the API queue to BullMQ):
  # redis:// or rediss:// URL — rediss:// when your Redis uses TLS (managed
  # Redis in k8s should). If the URL embeds a password it stays here, in the
  # Secret, never in the ConfigMap.
  REDIS_URL: "REPLACE_REDIS_URL"

  # OPTIONAL (api only — AI-assisted editing/vision). Leave EMPTY when unused:
  # config-schema treats an empty value as "not set" (present-but-empty), so
  # the vision client stays disabled instead of firing requests with a bogus
  # credential. Remove the line entirely if you prefer.
  ANTHROPIC_API_KEY: ""
  OPENAI_API_KEY: ""
  CUSTOM_API_KEY: ""

{
  "name": "cloner",
  "version": "0.1.0",
  "description": "Universal frontend cloner: URL+cookies / image / video → pixel-faithful, editable clone with live dashboard",
  "type": "module",
  "bin": {
    "cloner": "bin/cloner.js",
    "cloner-platform": "bin/platform.js"
  },
  "scripts": {
    "start": "node bin/cloner.js",
    "platform": "node bin/platform.js",
    "worker": "node src/workers/clone-worker.js",
    "test": "node scripts/test-vision.mjs && node scripts/test-integration.mjs",
    "test:platform": "node scripts/test-platform.mjs",
    "test:exploration": "node scripts/test-exploration.mjs && node scripts/test-exploration-fixtures.mjs",
    "test:reconstruction": "node scripts/test-reconstruction.mjs && node scripts/test-website-understanding.mjs && node scripts/test-workspace-reconstruction.mjs",
    "test:coverage": "node scripts/test-website-coverage.mjs",
    "test:component-intelligence": "node scripts/test-component-intelligence.mjs",
    "test:app-state": "node scripts/test-app-state-reconstruction.mjs",
    "test:complex-visuals": "node scripts/test-complex-visuals.mjs",
    "test:exploration-efficiency": "node scripts/test-exploration-efficiency.mjs",
    "test:generalization": "node scripts/test-generalization.mjs",
    "test:runtime-robustness": "node scripts/test-runtime-robustness.mjs",
    "test:visual-fidelity": "node scripts/test-visual-fidelity.mjs && node scripts/test-autonomous-repair.mjs",
    "test:benchmark": "node scripts/test-multisite-benchmark.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:tenant-isolation": "node scripts/test-tenant-isolation.mjs",
    "test:org-management": "node scripts/test-org-management.mjs",
    "test:worker-infra": "node scripts/test-worker-infra.mjs",
    "test:worker-queue": "node scripts/test-worker-queue.mjs",
    "test:quotas": "node scripts/test-quotas.mjs",
    "test:artifact-lifecycle": "node scripts/test-artifact-lifecycle.mjs",
    "test:api-keys": "node scripts/test-api-keys.mjs",
    "test:observability": "node scripts/test-observability.mjs",
    "test:admin-surfaces": "node scripts/test-admin-surfaces.mjs",
    "test:audit-logs": "node scripts/test-audit-logs.mjs",
    "test:deployment": "node scripts/test-deployment.mjs",
    "test:backup-recovery": "node scripts/test-backup-recovery.mjs",
    "test:phase40": "node scripts/test-tenant-isolation.mjs && node scripts/test-org-management.mjs && node scripts/test-worker-infra.mjs && node scripts/test-worker-queue.mjs && node scripts/test-quotas.mjs && node scripts/test-artifact-lifecycle.mjs && node scripts/test-api-keys.mjs && node scripts/test-observability.mjs && node scripts/test-admin-surfaces.mjs && node scripts/test-audit-logs.mjs && node scripts/test-deployment.mjs && node scripts/test-backup-recovery.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.5.3",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "playwright": "^1.49.1",
    "ws": "^8.18.0"
  }
}
